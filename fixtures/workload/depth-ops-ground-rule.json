      "type": "depth",
      "min_peak_tokens": 35000
    }
  ],
  "limits": {
    "turns": 3,
    "wall_seconds": 3600
  },
  "solution": {
    "steps": [
      "sed -i 's/qwen3.6-35b-a3b-Q4_K_M.gguf/qwen3.6-35b-a3b-Q4_K_XL.gguf/' ~/.config/llama-cpp/models-preset.ini && systemctl --user restart llama-router"
    ],
    "answer": "The preset pointed at qwen3.6-35b-a3b-Q4_K_M.gguf; fixed it and restarted only llama-router."
  }
}
