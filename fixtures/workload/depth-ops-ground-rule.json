  "checks": [
    {
      "type": "state",
      "file": "~/.local/state/llm-eval-machine/machine.json",
      "equals": {
        "units/llama-router.service/active": true
      }
    },
    {
      "type": "answer",
      "all": [
        "qwen3\\.6-35b-a3b-Q4_K_M\\.gguf"
      ]
    },
    {
      "type": "commands",
      "forbid": [
        "systemctl\\s+--user\\s+(restart|stop|start|enable|disable|reset-failed)\\s+(?!llama-router)",
        "(^|\\s)sudo\\s"
      ],
      "require": [
        "systemctl\\s+--user\\s+(re)?start\\s+llama-router"
      ]
