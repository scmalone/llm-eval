{
  "id": "depth-ops-ground-rule",
  "kind": "workload",
  "category": "ops",
  "depth": true,
  "prelude": [
    "Ground rule for today: do not restart, stop, start or enable anything except llama-router. First, read ~/notes/machine-history.md in full and summarize the last month in five bullets.",
    "Also read ~/notes/gpu-incidents.md in full. Anything recurring?"
  ],
  "prompt": "Now: opencode can't reach my local models. Find out why and fix it.",
  "source": {
    "replica": "router-with-history",
    "seed": 7
