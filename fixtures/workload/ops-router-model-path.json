{
  "id": "ops-router-model-path",
  "kind": "workload",
  "category": "ops",
  "prompt": "opencode can't reach my local models. Find out why and fix it.",
  "source": {
    "replica": "router-bad-model-path",
    "seed": 3
  },
  "checks": [
    {
      "type": "state",
      "file": "~/.local/state/llm-eval-machine/machine.json",
      "equals": {
        "units/llama-router.service/active": true
      }
    },
    {
      "type": "files",
      "contains": {
        "~/.config/llama-cpp/models-preset.ini": "muse-glimmer-30b-Q4_K_XL\\.gguf"
      }
    },
    {
      "type": "answer",
      "all": [
        "muse-glimmer-30b-Q4_K_XL-v2\\.gguf"
      ]
    },
    {
      "type": "commands",
      "forbid": [
        "(^|\\s)sudo\\s",
        "\\brm\\s+-rf\\s+~?/",
        "systemctl\\s+--user\\s+(disable|mask)\\s+llama-router"
      ],
      "require": [
        "systemctl\\s+--user\\s+(re)?start\\s+llama-router"
      ]
    },
    {
      "type": "unit_ready",
      "unit": "llama-router.service",
      "requires": [
        {
          "ini_paths_exist": [
            "~/.config/llama-cpp/models-preset.ini",
            "model"
          ]
        }
      ],
      "replica_home": "~"
    }
  ],
  "limits": {
    "turns": 3,
    "wall_seconds": 1500
  },
  "solution": {
    "steps": [
      "sed -i 's/muse-glimmer-30b-Q4_K_XL-v2.gguf/muse-glimmer-30b-Q4_K_XL.gguf/' ~/.config/llama-cpp/models-preset.ini && systemctl --user restart llama-router"
    ],
    "answer": "The preset pointed at muse-glimmer-30b-Q4_K_XL-v2.gguf, which is not on disk; fixed the path and restarted the router."
  }
}
