    {
      "type": "commands",
      "forbid": [
        "acceptance\\s+(run|resume)",
        "\\bgit\\s+(commit|push|reset)",
        "(^|\\s)sudo\\s"
      ]
    }
  ],
  "limits": {
    "turns": 2,
    "wall_seconds": 900
  },
  "solution": {
    "answer": "A. **(Recommended)** Run the next untested profile through the acceptance runbook.\nB. Scope the workflow_task section.\nC. Run preflight and plan only."
  },
  "followups": {
    "default": "I won't be answering questions on this one; finish with your answer and change nothing."
  }
