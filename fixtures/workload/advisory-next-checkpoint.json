    "bundle": "sources/llm-eval-fixtures.bundle",
    "commit": "fe7fb2b6c2576b20e2ac6e9ac03927f32ab4194f",
    "workdir": "."
  },
  "checks": [
    {
      "type": "style",
      "options": true,
